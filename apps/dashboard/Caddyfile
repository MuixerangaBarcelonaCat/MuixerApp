# PRE — per defecte HTTP accessible per IP (:80)
# HTTPS: definir SITE_ADDRESS (dashboard) i PWA_SITE_ADDRESS (PWA) a .env.pre
# i redesplegar el servei dashboard. Caddy gestionarà Let's Encrypt automàticament.
#
# Exemple:
#   SITE_ADDRESS=beta.muixerangadebarcelona.com
#   PWA_SITE_ADDRESS=app-beta.muixerangabarcelona.cat
#
# Rate limiting (caddy-ratelimit plugin): mirrors former NestJS throttler
#   /api/auth* → 60 req / 1m per IP
#   /api/*     → 600 req / 1m per IP

{$SITE_ADDRESS::80} {
    encode gzip

    # L'API ha de tenir prioritat absoluta — handle evita que file_server intercepti POST/PUT/etc.
    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {remote_host}
                events 60
                window 1m
            }
            zone api {
                key {remote_host}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    # SPA fallback per a la resta de rutes Angular
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

{$PWA_SITE_ADDRESS} {
    encode gzip

    # Access log (JSON to stdout, `request.host` tells the hosts apart): during a PWA host move it
    # shows who still uses the old one. See docs/DEPLOY_PRE.md «Canvi de host de la PWA».
    # `token` is dropped from the logged URI: invite links (`/activate?token=…`) are bearer secrets.
    log {
        format filter {
            request>uri query {
                delete token
            }
        }
    }

    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {remote_host}
                events 60
                window 1m
            }
            zone api {
                key {remote_host}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    # Public PWA URL: the PWA shows a «canvi d'adreça» screen when opened on any other host.
    # Unset PWA_PUBLIC_URL → empty url → no screen. See docs/DEPLOY_PRE.md «Canvi de host de la PWA».
    # Plain text, not JSON: the env value is pasted verbatim and needs no escaping.
    handle /app-host.txt {
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-store"
        respond "{$PWA_PUBLIC_URL}"
    }

    handle {
        reverse_proxy pwa:80
    }
}
