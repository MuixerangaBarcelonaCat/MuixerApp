# PRE — per defecte HTTP accessible per IP (:80)
# Per habilitar HTTPS: definir SITE_ADDRESS=pre.muixerapp.cat a .env.pre i redesplegar el servei dashboard.
# Caddy gestionarà els certificats Let's Encrypt automàticament sense cap altre canvi.
{$SITE_ADDRESS::80} {
    encode gzip

    # L'API ha de tenir prioritat absoluta — handle evita que file_server intercepti POST/PUT/etc.
    handle /api/* {
        reverse_proxy api:3000
    }

    # SPA fallback per a la resta de rutes Angular
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
