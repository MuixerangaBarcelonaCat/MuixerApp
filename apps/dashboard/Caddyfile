# PRE — per defecte HTTP accessible per IP (:80)
# HTTPS: definir SITE_ADDRESS (dashboard) i PWA_SITE_ADDRESS (PWA) a .env.pre
# i redesplegar el servei dashboard. Caddy gestionarà Let's Encrypt automàticament.
#
# Exemple:
#   SITE_ADDRESS=beta.muixerangadebarcelona.com
#   PWA_SITE_ADDRESS=app.beta.muixerangadebarcelona.com
#
# Rate limiting (caddy-ratelimit plugin): mirrors former NestJS throttler
#   /api/auth* → 10 req / 1m per IP
#   /api/*     → 600 req / 1m per IP

{$SITE_ADDRESS::80} {
    encode gzip

    # L'API ha de tenir prioritat absoluta — handle evita que file_server intercepti POST/PUT/etc.
    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {remote_host}
                events 10
                window 1m
            }
            zone api {
                key {remote_host}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    # SPA fallback per a la resta de rutes Angular
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

{$PWA_SITE_ADDRESS} {
    encode gzip

    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {remote_host}
                events 10
                window 1m
            }
            zone api {
                key {remote_host}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    handle {
        reverse_proxy pwa:80
    }
}
