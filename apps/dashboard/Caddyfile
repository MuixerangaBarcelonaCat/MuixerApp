# PRE — per defecte HTTP accessible per IP (:80)
# HTTPS: definir SITE_ADDRESS (dashboard) i PWA_SITE_ADDRESS (PWA) a .env.pre
# i redesplegar el servei dashboard. Caddy gestionarà Let's Encrypt automàticament.
#
# Exemple:
#   SITE_ADDRESS=beta.muixerangadebarcelona.com
#   PWA_SITE_ADDRESS=app-beta.muixerangabarcelona.cat
#
# Rate limiting (caddy-ratelimit plugin): mirrors former NestJS throttler. Key = client IP.
#   /api/auth*                                          → 60 req / 1m per IP
#   PWA host only: /api/me/events/*/segments/*/revision → 3000 req / 1m per IP (own zone, so the
#     live-sync poll of members behind one Wi-Fi/CGNAT IP doesn't eat the api budget)
#   /api/* (rest)                                       → 600 req / 1m per IP
#
# Client IP: the hosts sit behind Cloudflare, so the TCP peer is a Cloudflare node. The real IP is
# read from Cf-Connecting-Ip only when the peer is in the Cloudflare ranges below (pinned
# 2026-11-23 from https://www.cloudflare.com/ips-v4 and /ips-v6; refresh if Cloudflare changes them).
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers Cf-Connecting-Ip
    }
}

{$SITE_ADDRESS::80} {
    encode gzip

    # L'API ha de tenir prioritat absoluta — handle evita que file_server intercepti POST/PUT/etc.
    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {client_ip}
                events 60
                window 1m
            }
            zone api {
                key {client_ip}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    # SPA fallback per a la resta de rutes Angular
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

{$PWA_SITE_ADDRESS} {
    encode gzip

    # Access log (JSON to stdout, `request.host` tells the hosts apart): during a PWA host move it
    # shows who still uses the old one. See docs/DEPLOY_PRE.md «Canvi de host de la PWA».
    # Invite tokens are bearer secrets: redacted from the URI (`/activate?token=…` and
    # `/api/auth/invite/<token>`) and the Referer header (requests made from /activate carry it).
    log {
        format filter {
            request>uri regexp "(token=|/auth/invite/)[^&/?]+" "${1}REDACTED"
            request>headers>Referer delete
        }
    }

    handle /api/* {
        rate_limit {
            zone auth {
                match {
                    path /api/auth*
                }
                key {client_ip}
                events 60
                window 1m
            }
            zone revision {
                match {
                    path_regexp ^/api/me/events/[^/]+/segments/[^/]+/revision$
                }
                key {client_ip}
                events 3000
                window 1m
            }
            zone api {
                match {
                    not path_regexp ^/api/me/events/[^/]+/segments/[^/]+/revision$
                }
                key {client_ip}
                events 600
                window 1m
            }
        }
        reverse_proxy api:3000
    }

    # Public PWA URL: the PWA shows a «canvi d'adreça» screen when opened on any other host.
    # Unset PWA_PUBLIC_URL → empty url → no screen. See docs/DEPLOY_PRE.md «Canvi de host de la PWA».
    # Plain text, not JSON: the env value is pasted verbatim and needs no escaping.
    handle /app-host.txt {
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-store"
        respond "{$PWA_PUBLIC_URL}"
    }

    handle {
        reverse_proxy pwa:80
    }
}
