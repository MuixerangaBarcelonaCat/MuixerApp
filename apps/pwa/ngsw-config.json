{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/images/**", "/icons/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "colla-settings",
      "urls": ["/api/colla-settings", "/api/colla-settings/public"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "30d",
        "maxSize": 2
      }
    },
    {
      "name": "segment-projection",
      "urls": ["/api/me/events/*/segments/*/projection"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "12h",
        "maxSize": 20
      }
    }
  ]
}
