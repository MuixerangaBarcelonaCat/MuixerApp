{
  "name": "pinyes-render",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pinyes-render/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["type:lib", "scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/pinyes-render/ng-package.json",
        "tsConfig": "libs/pinyes-render/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/pinyes-render/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      },
      "configurations": {
        "ci": {
          "coverage": true,
          "runnerConfig": "libs/pinyes-render/vitest.config.ts"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
