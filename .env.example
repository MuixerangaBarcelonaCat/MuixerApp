# Database — Docker PostgreSQL (default for local development)
DATABASE_URL=postgresql://muixer:muixer_dev_pass@localhost:5433/muixer_dev
# For production VPS: use the internal Docker network hostname
# DATABASE_URL=postgresql://muixer_prod:<password>@postgres:5432/muixer_prod

# SSL — set to 'true' only for remote managed databases (Neon, RDS, etc.)
# When true, DB_SSL_CA (the provider's CA certificate, PEM content) is required —
# the app refuses to start without it rather than connect with an unverified cert (SEC-15).
DB_SSL=false
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

NODE_ENV=development
PORT=3000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# Legacy API (sync)
LEGACY_API_URL=https://colla-muixeranguera.appsistencia.cat
LEGACY_API_USERNAME=XXXXXX
LEGACY_API_PASSWORD=XXXXXX

# JWT — Access Token
JWT_SECRET=change-me-strong-random-secret
JWT_ACCESS_TTL=900

# Refresh Token — opaque random string, hashed and stored in the DB
# Temps de vida dels refresh tokens per a cada client (dashboard o PWA).
# 28800 = 8 hours
JWT_REFRESH_TTL_DASHBOARD=28800
# 604800 = 7 days
JWT_REFRESH_TTL_PWA=604800

# Refresh token cookie name
REFRESH_TOKEN_COOKIE=muixer_rt

# Bootstrap setup endpoint — remove from production after first user is created
SETUP_TOKEN=change-me-random-uuid

# Assignment lock — days after event date to lock assignments (0 = disabled)
ASSIGNMENT_LOCK_DAYS=2
DB_SYNC=true
COOKIE_SECURE=false

SITE_ADDRESS=domini.cat
PWA_SITE_ADDRESS=app.domini.cat
CORS_ORIGINS=https://domini.catt,https://app.domini.cat
COOKIE_SECURE=true