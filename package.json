{
  "name": "muixer-app",
  "version": "1.0.0",
  "description": "MuixerApp - Attendance & figure management for Muixerangues",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.19.0 <23.0.0"
  },
  "scripts": {
    "dev:db": "docker compose up -d",
    "dev:api": "nx serve api --no-watch",
    "dev:dashboard": "nx serve dashboard",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "docker:clean": "docker compose down -v",
    "docker:psql": "docker exec -it muixer-postgres-dev psql -U muixer -d muixer_dev",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:pre:up": "docker compose -f docker-compose.pre.yml up -d --build",
    "docker:pre:down": "docker compose -f docker-compose.pre.yml down",
    "docker:pre:logs": "docker compose -f docker-compose.pre.yml logs -f",
    "docker:pre:ps": "docker compose -f docker-compose.pre.yml ps",
    "db:reset-figures": "docker exec -i muixer-postgres-dev psql -U muixer -d muixer_dev < scripts/reset-figure-data-safe.sql",
    "migration:generate": "nx run api:migration-generate --name",
    "migration:create": "nx run api:migration-create --name",
    "migration:run": "nx run api:migration-run",
    "migration:revert": "nx run api:migration-revert",
    "migration:show": "nx run api:migration-show",
    "audit:responsive": "playwright test -c apps/dashboard-e2e/playwright.audit.config.ts",
    "audit:report": "playwright show-report apps/dashboard-e2e/playwright-report-audit",
    "audit:pwa": "playwright test -c apps/dashboard-e2e/playwright.pwa-audit.config.ts",
    "audit:gestures": "playwright test -c apps/dashboard-e2e/playwright.gestures.config.ts",
    "audit:pwa-behavior": "playwright test -c apps/dashboard-e2e/playwright.pwa-behavior.config.ts",
    "ci:local": "npx nx run-many -t lint,test,build --all --exclude=dashboard-e2e,pwa-e2e --parallel=3 --configuration=ci"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-personal:MuixerangaBarcelonaCat/MuixerApp.git"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.19",
    "@angular-devkit/schematics": "~21.2.19",
    "@angular/build": "~21.2.19",
    "@angular/cli": "~21.2.19",
    "@angular/compiler-cli": "~21.2.18",
    "@angular/language-service": "~21.2.18",
    "@eslint/js": "^9.39.5",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@nx/angular": "^22.7.7",
    "@nx/devkit": "22.6.3",
    "@nx/eslint": "22.6.3",
    "@nx/eslint-plugin": "22.6.3",
    "@nx/jest": "22.6.3",
    "@nx/js": "^22.7.7",
    "@nx/nest": "^22.7.7",
    "@nx/node": "22.6.3",
    "@nx/playwright": "22.6.3",
    "@nx/web": "22.6.3",
    "@nx/webpack": "22.6.3",
    "@nx/workspace": "^22.7.7",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.61.1",
    "@schematics/angular": "~21.2.19",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.43",
    "@swc/helpers": "~0.5.23",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.5.3",
    "daisyui": "^4.12.24",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^1.8.3",
    "jest": "^30.4.2",
